[Unit]
Description=Run RMUC live schedule sync periodically

[Timer]
# Pin the regional competition cadence to China Standard Time.
# 00:00-06:00: every 30 minutes. Remaining time: every 30 seconds.
OnCalendar=*-*-* 00..05:00/30:00 Asia/Shanghai
OnCalendar=*-*-* 06:00:00 Asia/Shanghai
OnCalendar=*-*-* 06:00:30 Asia/Shanghai
OnCalendar=*-*-* 06:01..59:0/30 Asia/Shanghai
OnCalendar=*-*-* 07..23:*:0/30 Asia/Shanghai
AccuracySec=5s
RandomizedDelaySec=5s
Persistent=true
Unit=rmuc-live-sync.service

[Install]
WantedBy=timers.target
